# Claude: powers enquiry reading, reply drafting and price-list import.
# Without it Matchire falls back to its built-in rules-based parser and reply templates.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
MATCHIRE_MODEL=

# Public URL of this deployment (used in links and webhooks)
APP_URL=http://localhost:3000
# Where the SQLite database lives (needs a persistent disk in production)
DATA_DIR=./data

# Protects /api/cron for external schedulers (follow-ups and hold expiry also run in-process every minute)
CRON_SECRET=

# WhatsApp Cloud API (Meta). Per-vendor phone number ID and token are set in Settings;
# these are app-level values shared by every vendor.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Outbound email over SMTP, e.g. a Google Workspace mailbox (needs 2-Step Verification and an app password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=giuseppe.mennella@matchire.ai
SMTP_PASS=
# Optional: defaults to the SMTP mailbox. With Gmail it must be that address or one of its aliases.
EMAIL_FROM="Matchire <hello@matchire.ai>"
# Alternative to SMTP: Resend (https://resend.com). Used only when SMTP isn't set.
RESEND_API_KEY=

# Early-access sign-ups from the landing page are emailed here (needs RESEND_API_KEY)
EARLY_ACCESS_NOTIFY_EMAIL=giuseppe.mennella@matchire.ai
# Logins that can see the admin pages (comma-separated). If unset, the first account created is the admin.
ADMIN_EMAILS=
